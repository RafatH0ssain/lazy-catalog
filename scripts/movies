#!/usr/bin/env zsh
# movies — open the library in the browser.
#
#   movies             open the library
#   movies --refresh   catalogue anything new first, then open
#   movies --port 9000 anything else is passed straight through
#
# Ctrl+C stops it. The page is served from localhost rather than opened off
# disk because clicking a poster hands the file to VLC, and a page loaded from
# file:// has no way to launch an app. If a library is already being served,
# this opens the tab and leaves the running one alone.

set -e

REPO="${0:A:h:h}"
PYTHON="${LAZY_CATALOG_PYTHON:-python3}"

cd "$REPO"

if [[ "$1" == "--refresh" || "$1" == "-r" ]]; then
  shift
  "$PYTHON" -m lazycatalog update
fi

exec "$PYTHON" -m lazycatalog serve "$@"
